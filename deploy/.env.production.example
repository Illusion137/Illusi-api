# /opt/illusi/.env on the VPS. scripts/preinstall.sh creates it with random secrets.
# Compose reads it for interpolation and passes it to the api/worker/migrate containers.

DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com
# Host directory for postgres, media, certificates and backups.
DATA_DIR=/opt/illusi/data

POSTGRES_USER=illusi
POSTGRES_DB=illusi
# Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# 32+ random chars each; the two keys must differ
JWT_ACCESS_SECRET=
ACTION_TOKEN_SECRET=

NODE_ENV=production
ITUNES_COUNTRY=US
ITUNES_LIVE_TO_BACKFILL=3:1
ANALYZER_CONCURRENCY=1
ANALYZER_JOB_TIMEOUT_MS=300000
MEDIA_MAX_BYTES=209715200
LYRICS_RECHECK_AFTER_DAYS=14
SC_TRANSCODING_STALE_AFTER_HOURS=24
RECONCILE_INCREMENTAL_INTERVAL_MIN=15
RECONCILE_DRY_RUN=false
NEW_RELEASES_WINDOW_DAYS=7
NEW_RELEASES_RECHECK_HOURS=12
NEW_RELEASES_REQUEST_COOLDOWN_MIN=30
NEW_RELEASES_MAX_ACTIONS=25
SHUTDOWN_GRACE_MS=25000

# Encrypts the daily database dumps (scripts/backup.sh). Keep a copy outside the VPS (password manager):
# without it the dumps can't be restored. Empty: dumps stay unencrypted and are never uploaded.
BACKUP_ENCRYPTION_KEY=

# Off-site copies in S3-compatible object storage: every media file (scripts/backup-media.sh, every 15 min) and
# the encrypted database dumps (scripts/backup.sh, daily). Contabo: Object Storage panel -> create the bucket,
# then "S3 credentials". Leave the endpoint empty to disable.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Images. scripts/deploy.sh pins the tags in .env.deploy.
API_IMAGE=ghcr.io/illusion137/illusi-api
ANALYZER_IMAGE=ghcr.io/illusion137/illusi-analyzer
