# /opt/illusi/.env on the VPS. scripts/preinstall.sh creates it with random secrets.
# Compose reads it for interpolation and passes it to the api/worker/migrate containers.

DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com
# Host directory for postgres, media, certificates and backups.
DATA_DIR=/opt/illusi/data

POSTGRES_USER=illusi
POSTGRES_DB=illusi
# Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Role the API serves authenticated requests with (row-level security applies to it). The migrate service creates it
# and syncs this password on every deploy. Hex only.
POSTGRES_APP_USER=illusi_app
POSTGRES_APP_PASSWORD=

# Email confirmation through Resend (resend.com -> API Keys, and verify the sending domain under Domains).
# Empty RESEND_API_KEY sends nothing: users could never confirm, so set it before going live.
RESEND_API_KEY=
EMAIL_FROM=Illusi <no-reply@mail.example.com>
# Where the confirmation link points: the public https URL of this API.
PUBLIC_API_URL=https://api.example.com
EMAIL_VERIFICATION_TTL_HOURS=24
# Browsers may call the API from this domain and its subdomains.
CORS_ALLOWED_DOMAIN=sumii.me

# 32+ random chars each; the two keys must differ
JWT_ACCESS_SECRET=
ACTION_TOKEN_SECRET=

NODE_ENV=production
ITUNES_COUNTRY=US
ITUNES_LIVE_TO_BACKFILL=3:1
ANALYZER_CONCURRENCY=1
ANALYZER_JOB_TIMEOUT_MS=300000
MEDIA_MAX_BYTES=209715200
MEDIA_AAC_BITRATE=256k
MEDIA_TRANSCODE_CONCURRENCY=2
LYRICS_RECHECK_AFTER_DAYS=14
SC_TRANSCODING_STALE_AFTER_HOURS=24
RECONCILE_INCREMENTAL_INTERVAL_MIN=15
RECONCILE_DRY_RUN=false
NEW_RELEASES_WINDOW_DAYS=7
NEW_RELEASES_RECHECK_HOURS=12
NEW_RELEASES_REQUEST_COOLDOWN_MIN=30
NEW_RELEASES_MAX_ACTIONS=25
SHUTDOWN_GRACE_MS=25000

# Postgres memory, sized for a ~4 GB VPS shared with the API and analyzer. For 8 GB: 2GB / 5GB / 32MB / 512MB.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
# Statements slower than this are logged by Postgres (docker logs of the db container).
PG_LOG_SLOW_MS=1000
# API connection pool. A query running longer than DB_STATEMENT_TIMEOUT_MS is cancelled (the worker allows longer).
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# libuv threads for the API: argon2 hashing and file I/O share them.
UV_THREADPOOL_SIZE=16

# Free disk space thresholds: below DISK_WARN_FREE_GB an error goes to Sentry (time to upgrade storage); below
# DISK_MIN_FREE_GB every file upload is refused with 507 while database writes continue.
DISK_WARN_FREE_GB=10
DISK_MIN_FREE_GB=5
# Playlist artwork: largest upload, and the longest side it's scaled down to (stored as JPEG).
ARTWORK_MAX_BYTES=10485760
ARTWORK_MAX_PX=1024
# Data exports: kept this many days once ready; one request per user per cooldown.
EXPORT_TTL_DAYS=7
EXPORT_COOLDOWN_HOURS=24
# Log files in $DATA_DIR/logs, one per service per day.
LOG_RETENTION_DAYS=7

# Sentry (sentry.io project -> Settings -> Client Keys). Gets uncaught and error-level events only, plus the
# scheduled jobs' cron check-ins (scripts/cron.sh) and the reconcile worker's. Empty disables both.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Encrypts the daily database dumps (scripts/backup.sh). Keep a copy outside the VPS (password manager):
# without it the dumps can't be restored. Empty: dumps stay unencrypted and are never uploaded.
BACKUP_ENCRYPTION_KEY=

# Off-site copies in S3-compatible object storage: every media file (scripts/backup-media.sh, every 15 min) and
# the encrypted database dumps (scripts/backup.sh, daily). Contabo: Object Storage panel -> create the bucket,
# then "S3 credentials". Leave the endpoint empty to disable.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Images. scripts/deploy.sh pins the tags in .env.deploy.
API_IMAGE=ghcr.io/illusion137/illusi-api
ANALYZER_IMAGE=ghcr.io/illusion137/illusi-analyzer
