# Included inside every vhost's server{} block by nginx-proxy (no host-specific file exists).

# 120 requests per minute per IP (zone in conf.d/illusi.conf). The burst lets an app start fire its batch of
# requests at once; past it, requests over the rate get a JSON 429.
limit_req zone=per_ip burst=60 nodelay;
limit_req zone=auth_per_ip burst=10 nodelay;
limit_req_status 429;
error_page 429 = @rate_limited;
location @rate_limited {
	default_type application/json;
	add_header Retry-After 60 always;
	return 429 '{"error":"too many requests"}';
}

# Media files, after the API has checked access: it answers with X-Accel-Redirect to this location (MEDIA_ACCEL_PREFIX).
# Not reachable from outside. nginx handles Range and If-Range itself; the API's ETag is kept as the validator, and
# Content-Type and Cache-Control are passed through from the API response.
location ^~ /_internal_media/ {
	internal;
	alias /data/media/;
	etag off;
	add_header ETag $upstream_http_etag always;
}
