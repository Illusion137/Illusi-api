# Role for authenticated requests; row-level security applies to it (created by `npm run db:migrate`).
DATABASE_URL=""
# Table owner: migrations, background jobs, login. Without it everything uses DATABASE_URL and RLS is bypassed.
MIGRATE_DATABASE_URL=""
JWT_ACCESS_SECRET=""
ACTION_TOKEN_SECRET=""
PORT=3000
ITUNES_COUNTRY=US
ITUNES_LIVE_TO_BACKFILL=3:1
ANALYZER_URL=http://127.0.0.1:8765
ANALYZER_TMP_DIR=./data/analyzer_tmp
ANALYZER_CONCURRENCY=1
ANALYZER_JOB_TIMEOUT_MS=300000
ANALYZER_ALIGNMENT_TIMEOUT_MS=1200000
MEDIA_DIR=./data/media
MEDIA_MAX_BYTES=209715200
MEDIA_AAC_BITRATE=256k
MEDIA_TRANSCODE_CONCURRENCY=2
# Set behind nginx (compose sets /_internal_media/); empty streams media from Node.
MEDIA_ACCEL_PREFIX=
# Media bucket (scripts/backup-media.sh). Media missing from MEDIA_DIR redirects to MEDIA_PUBLIC_URL/<file>; empty keeps media on disk.
MEDIA_PUBLIC_URL=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
LYRICS_RECHECK_AFTER_DAYS=14
# LRCLib app credentials. Empty queries LRCLib anonymously.
LRCLIB_APP_ID=
LRCLIB_API_KEY=
SC_TRANSCODING_STALE_AFTER_HOURS=24
RECONCILE_INCREMENTAL_INTERVAL_MIN=15
RECONCILE_DRY_RUN=false
NEW_RELEASES_WINDOW_DAYS=7
NEW_RELEASES_RECHECK_HOURS=12
NEW_RELEASES_REQUEST_COOLDOWN_MIN=30
NEW_RELEASES_MAX_ACTIONS=25
NEW_RELEASES_SERVER_INTERVAL_MIN=10
NEW_RELEASES_SERVER_BATCH=25
TRUST_PROXY=loopback
# Email confirmation (Resend). Empty RESEND_API_KEY logs the confirmation link instead of sending it.
RESEND_API_KEY=
EMAIL_FROM="Illusi <no-reply@sumii.me>"
PUBLIC_API_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24
CORS_ALLOWED_DOMAIN=sumii.me
SHUTDOWN_GRACE_MS=25000
DISK_WARN_FREE_GB=10
DISK_MIN_FREE_GB=5
ARTWORK_MAX_BYTES=10485760
ARTWORK_MAX_PX=1024
AVATAR_MAX_PX=512
EXPORT_TTL_DAYS=7
EXPORT_COOLDOWN_HOURS=24
LOG_DIR=./data/logs
LOG_SERVICE=api
LOG_RETENTION_DAYS=7
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_CRONS=false
