{
  "name": "illusiv",
  "version": "1.0.0",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "worker:reconcile": "npx tsx src/worker/reconcile.ts",
    "typecheck": "tsc --noEmit -p . | grep -E '^src/' && exit 1 || exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "test:integration:local": "scripts/test-integration.sh",
    "test:coverage:all": "rm -rf coverage-merged && vitest run --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage-merged/unit > /dev/null && scripts/test-integration.sh --coverage > /dev/null && node scripts/merge-coverage.mjs coverage-merged 80 --html coverage"
  },
  "description": "",
  "homepage": "https://github.com/Illusion137/Illusi-api#readme",
  "bugs": {
    "url": "https://github.com/Illusion137/Illusi-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Illusion137/Illusi-api.git"
  },
  "license": "MIT",
  "author": "Sumi!",
  "type": "commonjs",
  "main": "index.ts",
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "@sentry/profiling-node": "^11.9.0",
    "argon2": "^0.45.1",
    "buffer": "^6.0.3",
    "busboy": "^1.6.0",
    "colors": "^1.4.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "fuzzysort": "^3.1.0",
    "jose": "^6.2.13",
    "jsdom-jscore-rn": "^0.1.9",
    "mysql2": "^3.24.6",
    "path-browserify": "^1.0.1",
    "pg": "^8.23.1",
    "react-native-uuid": "^2.0.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "c8": "^12.0.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
